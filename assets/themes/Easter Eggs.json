    "font": {
      "family": "Comic Sans MS",
      "sizePt": 42,
      "bold": true,
      "italic": false,
      "underline": false,
      "strikeout": false
    },
    "color": "#FFFF00",
    "picture": "bundled:Easter Bunny.BMP",
    "placement": "center"
  }
}
