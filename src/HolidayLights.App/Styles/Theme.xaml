<!--
  Design tokens and shared styles (owner: settings-ui; PRODUCT-SPEC 4.2, 4.5). App.xaml merges this dictionary next to the
  Fluent theme. Keys used by other owners are listed in AppResourceKeys (Contracts/AppResources.cs) and keep their names.

  Rules for this dictionary:
  * Fluent resources are referenced with DynamicResource only (never StaticResource or BasedOn), so the styles work
    whether the Fluent dictionary lives in Application.Resources (ThemeMode="System") or in a window, and they follow
    light, dark and High Contrast live.
  * Content colours (night wells, stages, the heritage sky) are fixed in light and dark mode; High Contrast replaces the
    night well with the system Window colour (HighContrastResources and the NightWell control).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:HolidayLights.App.Controls">

    <!-- Content tokens (PRODUCT-SPEC 4.2). -->
    <LinearGradientBrush x:Key="HL.Brush.NightWell" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14203A" Offset="0" />
        <GradientStop Color="#1F3157" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HL.Brush.NightGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1530" Offset="0" />
        <GradientStop Color="#1D3466" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HL.Brush.TaskbarBand" Color="#D9202020" />
    <SolidColorBrush x:Key="HL.Brush.StageBezel" Color="#3A3A3A" />
    <SolidColorBrush x:Key="HL.Brush.HeritageSky" Color="#DDEEFF" />

    <!-- Text drawn on night wells and stages (always light: the wells are dark in every mode). -->
    <SolidColorBrush x:Key="HL.Brush.OnNightWell" Color="#F5F8FF" />
    <SolidColorBrush x:Key="HL.Brush.OnNightWellSecondary" Color="#B8C4DD" />
    <SolidColorBrush x:Key="HL.Brush.StagePill" Color="#E6202020" />

    <!-- Illustration palette (PRODUCT-SPEC 4.2): app and tray icons, layer-mode illustrations, badges. -->
    <Color x:Key="HL.Color.BulbRed">#E3342F</Color>
    <Color x:Key="HL.Color.HollyGreen">#1F8B4C</Color>
    <Color x:Key="HL.Color.WarmGold">#F4B942</Color>
    <Color x:Key="HL.Color.SnowWhite">#F5F8FF</Color>
    <Color x:Key="HL.Color.IceBlue">#CFE8FF</Color>
    <SolidColorBrush x:Key="HL.Brush.WarmGold" Color="#F4B942" />
    <SolidColorBrush x:Key="HL.Brush.BulbRed" Color="#E3342F" />

    <!-- Type and icons. -->
    <FontFamily x:Key="HL.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Spacing grid (4 / 8 / 12 / 16 / 24; page padding 24; group gap 16). -->
    <Thickness x:Key="HL.Thickness.PagePadding">24,0,24,24</Thickness>
    <Thickness x:Key="HL.Thickness.GroupGap">0,0,0,16</Thickness>
    <CornerRadius x:Key="HL.CornerRadius.Card">8</CornerRadius>
    <CornerRadius x:Key="HL.CornerRadius.Tile">4</CornerRadius>
    <sys:Double x:Key="HL.Size.ChipRadius">4</sys:Double>

    <!-- Cards: the 5.4 group boxes. -->
    <Style x:Key="HL.Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Text styles (Segoe UI Variable is the Fluent default font). -->
    <Style x:Key="HL.Style.Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HL.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Button content "glyph + label" (ButtonContent.Glyph); the label may carry an access key ("_Peek"). -->
    <DataTemplate x:Key="HL.Template.GlyphLabel">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Glyph" Text="{Binding (controls:ButtonContent.Glyph), RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                       FontFamily="{StaticResource HL.Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
            <AccessText Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding (controls:ButtonContent.Glyph), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Radio button and check box content with a secondary line (TwoLineLabel); both lines dim with the control. -->
    <DataTemplate x:Key="HL.Template.TwoLine" DataType="{x:Type controls:TwoLineLabel}">
        <StackPanel>
            <AccessText Text="{Binding Label}" TextWrapping="Wrap" />
            <TextBlock x:Name="Description" Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="False">
                <Setter TargetName="Description" Property="Opacity" Value="0.55" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ToggleSwitch (PRODUCT-SPEC 3.0.1): a CheckBox with a track and thumb, "On"/"Off" text; the label on the left. -->
    <Style x:Key="HL.Style.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="0,0,16,0" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StateText" Text="Off" MinWidth="28" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                            <Grid Width="40" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource ToggleSwitchFillOff}"
                                        BorderBrush="{DynamicResource ToggleSwitchStrokeOff}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StateText" Property="Text" Value="On" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A transparent button for icons and secondary commands (hover and press fills like Fluent's subtle buttons). -->
    <Style x:Key="HL.Style.Button.Subtle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The subtle look for toggle buttons (favorite stars, the navigation [=] button): checked keeps the hover fill. -->
    <Style x:Key="HL.Style.ToggleButton.Subtle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A link-looking button ("Windows Volume Mixer", "More Display Settings...", status-line actions). -->
    <Style x:Key="HL.Style.Button.Link" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource HyperlinkButtonForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HyperlinkButtonBackgroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HyperlinkButtonBackgroundPressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource HyperlinkButtonForegroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HyperlinkButtonForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segments of a SegmentedControl ("Look", "Tiles/Details", the quick targets): joined radio buttons. -->
    <Style x:Key="HL.Style.Segment" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="4" Margin="2" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The frame around segments. -->
    <Style x:Key="HL.Style.SegmentFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Filter chips (Music Box categories): pills that show their count. -->
    <Style x:Key="HL.Style.Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small pill on tiles and cards ("New", "Big", "Current", "Changed", "Built-In"). -->
    <Style x:Key="HL.Style.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HL.Style.Badge.Accent" TargetType="Border" BasedOn="{StaticResource HL.Style.Badge}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HL.Style.Text.Badge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Group headers inside a page that are not cards ("Choose a Theme", "My Themes"). -->
    <Style x:Key="HL.Style.Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource HL.Style.Text.BodyStrong}">
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

</ResourceDictionary>
