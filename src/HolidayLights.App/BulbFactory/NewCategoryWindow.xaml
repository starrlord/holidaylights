<!--
  New Category (owner: bulb-factory; PRODUCT-SPEC 3.3.2): "Create a new bulb category named:",
  at most 39 characters; OK is enabled when the name has a letter or digit.
-->
<Window x:Class="HolidayLights.App.BulbFactory.NewCategoryWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Category" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <StackPanel Margin="24">
        <Label Content="Create a new bulb category named:" Target="{Binding ElementName=NameBox}" Padding="0"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBox x:Name="NameBox" Margin="0,8,0,0" MaxLength="39"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Category name" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="OK" MinWidth="96" IsDefault="True" IsEnabled="{Binding CanCreate}" Click="OnOkClick"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
