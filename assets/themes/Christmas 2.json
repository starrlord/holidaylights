{
  "schema": "holidaylights.theme/1",
  "name": "Christmas 2",
  "shipped": "classic",
  "arrangement": {
    "top": [
      "builtin:standard-bulbs",
      "builtin:shiny-baubles"
    ],
    "right": [
      "builtin:standard-bulbs",
      "builtin:shiny-baubles"
    ],
    "bottom": [
      "builtin:standard-bulbs",
      "builtin:snow-family"
    ],
    "left": [
      "builtin:standard-bulbs",
      "builtin:shiny-baubles"
    ],
    "topLeft": "builtin:jolly-holly",
    "topRight": "builtin:jolly-holly",
    "bottomLeft": "builtin:jolly-holly",
    "bottomRight": "builtin:jolly-holly"
  },
  "flash": {
    "pattern": "flashTogether",
    "interval": 5
  },
  "music": {
    "enabledSongs": [
      "bundled:A Very Merry Christmas.mid",
      "bundled:Almost Time for Christmas.mid",
      "bundled:Angels We Have Heard On High.mid",
      "bundled:Deck the Halls (Reggae).mid",
      "bundled:Deck the Halls.mid",
      "bundled:First Noel.mid",
      "bundled:God Rest Ye Merry Gentlemen (Reggae).mid",
      "bundled:God Rest Ye Merry Gentlemen.mid",
      "bundled:Good Christian Men.mid",
      "bundled:Good King Wenceslaus.mid",
      "bundled:Greensleeves.mid",
      "bundled:Hark the Herald Angels Sing.mid",
      "bundled:Here We Come A-Caroling.mid",
      "bundled:In a Manger.mid",
      "bundled:It Came Upon A Midnight.mid",
      "bundled:Jingle Bells (Reggae).mid",
      "bundled:Jingle Bells.mid",
      "bundled:Jolly Old St. Nick.mid",
      "bundled:Joy of Man's Desire (Reggae).mid",
      "bundled:Joy of Man's Desire.mid",
      "bundled:Joy to the World.mid",
      "bundled:O Christmas Tree (Swing).mid",
      "bundled:O Christmas Tree.mid",
      "bundled:O Come, All Ye Faithful.mid",
      "bundled:O Little Town of Bethlehem.mid",
      "bundled:Silent Night.mid",
      "bundled:Twelve Days of Christmas.mid",
      "bundled:We Three Kings.mid",
      "bundled:We Wish You a Merry Christmas (Reggae).mid",
      "bundled:We Wish You a Merry Christmas.mid",
      "bundled:What Child Is This.mid"
    ],
    "mode": "always"
  },
  "saver": {
    "animation": "Santa",
    "message": "Merry Christmas!",
    "font": {
      "family": "Lucida Handwriting",
      "sizePt": 48,
      "bold": true,
      "italic": false,
      "underline": false,
      "strikeout": false
    },
    "color": "#FF0000",
    "picture": "bundled:Snowman.BMP",
    "placement": "center"
  }
}
