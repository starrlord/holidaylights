<!--
  Edit Categories (owner: bulb-factory; PRODUCT-SPEC 3.3.2): the 5.4 text, the category check
  list, "New...", "Save" and "Cancel".
-->
<Window x:Class="HolidayLights.App.BulbFactory.EditCategoriesWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HolidayLights.App.BulbFactory"
        Title="{Binding Title}" Width="420" Height="540" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Content="Use the checkboxes to choose one or more categories for this bulb." Target="{Binding ElementName=CategoryList}" Padding="0"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <Label.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Label.ContentTemplate>
        </Label>

        <Border Grid.Row="1" Margin="0,12,0,0" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="8,4">
                <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories.Items}"
                              Focusable="True" IsTabStop="False" GotKeyboardFocus="OnCategoryListFocused"
                              KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"
                              AutomationProperties.Name="Categories">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CategoryItem}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="_New…" MinWidth="96" Command="{Binding NewCategoryCommand}"
                    ToolTip="{DynamicResource HL.Tip.BulbEditing.NewCategory}" />
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Save" MinWidth="96" IsDefault="True" Command="{Binding SaveCommand}"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
