<!--
  The "Bulb Factory" page (owner: settings-ui; PRODUCT-SPEC 3.2). Wide layout: the frame editor, quick targets, Flash
  Settings, Bulb Drawing and the theme buttons in a scrolling left column, the Bulb List with its selected-bulb bar on
  the right. Narrow layout (content width < 900): one scrolling column (BulbFactoryPage.xaml.cs moves the parts).
-->
<UserControl x:Class="HolidayLights.App.Settings.Pages.BulbFactoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HolidayLights.App.Controls"
             xmlns:gallery="clr-namespace:HolidayLights.App.Gallery"
             xmlns:groups="clr-namespace:HolidayLights.App.Settings.Groups"
             AutomationProperties.Name="Bulb Factory">
    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="GapColumn" Width="16" />
            <ColumnDefinition x:Name="RightColumn" Width="360" />
        </Grid.ColumnDefinitions>

        <!-- The column scrolls into the gap, so its scroll bar never covers the frame editor's right edge. -->
        <ScrollViewer x:Name="LeftScroller" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      PanningMode="VerticalOnly">
            <StackPanel x:Name="LeftStack" Margin="0,0,16,12">
                <StackPanel x:Name="InfoBars">
                    <controls:InfoBar x:Name="MissingBar" IsOpen="False" Severity="Warning" ActionText="Remove Missing Bulbs" IsClosable="True" Margin="0,0,0,8" />
                    <controls:InfoBar x:Name="AutomaticBar" IsOpen="False" Severity="Informational" ActionText="Save as Theme…"
                                      SecondaryActionText="Turn Off Automatic Themes" IsClosable="True" Margin="0,0,0,8" />
                    <controls:InfoBar x:Name="DamagedBar" IsOpen="False" Severity="Warning" ActionText="Show in Folder" IsClosable="True" Margin="0,0,0,8" />
                    <controls:InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />
                    <controls:InfoBar x:Name="SoftwareDrawingBar" IsOpen="False" Severity="Informational" IsClosable="True" Margin="0,0,0,8"
                                      Message="Holiday Lights had trouble drawing the lights and switched to software drawing." />
                </StackPanel>

                <controls:ArrangementEditor x:Name="Editor" />

                <WrapPanel x:Name="QuickTargets" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Use a bulb for:" VerticalAlignment="Center" Margin="0,0,10,6" />
                    <Border Style="{DynamicResource HL.Style.SegmentFrame}" Margin="0,0,10,6" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Use a bulb for">
                            <ToggleButton x:Name="WholeFrameButton" Style="{DynamicResource HL.Style.Segment}" Content="Whole _Frame" Click="OnQuickTargetClick" Checked="OnQuickTargetToggled" Unchecked="OnQuickTargetToggled"
                                          ToolTip="{DynamicResource HL.Tip.BulbFactory.WholeFrame}" AutomationProperties.Name="Whole Frame" />
                            <ToggleButton x:Name="AllEdgesButton" Style="{DynamicResource HL.Style.Segment}" Content="All Ed_ges" Click="OnQuickTargetClick" Checked="OnQuickTargetToggled" Unchecked="OnQuickTargetToggled"
                                          ToolTip="{DynamicResource HL.Tip.BulbFactory.AllEdges}" AutomationProperties.Name="All Edges" />
                            <ToggleButton x:Name="AllCornersButton" Style="{DynamicResource HL.Style.Segment}" Content="All Cor_ners" Click="OnQuickTargetClick" Checked="OnQuickTargetToggled" Unchecked="OnQuickTargetToggled"
                                          ToolTip="{DynamicResource HL.Tip.BulbFactory.AllCorners}" AutomationProperties.Name="All Corners" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="or select a box" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </WrapPanel>

                <Grid x:Name="GroupsGrid" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FlashColumn" Width="*" />
                        <ColumnDefinition x:Name="GroupGapColumn" Width="12" />
                        <ColumnDefinition x:Name="DrawingColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="GroupGapRow" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <groups:FlashSettingsGroup x:Name="FlashGroup" />
                    <groups:BulbDrawingGroup x:Name="DrawingGroup" Grid.Column="2" />
                </Grid>

                <WrapPanel x:Name="ThemeButtons" Margin="0,16,0,0">
                    <Button Content="_Load Theme…" Margin="0,0,8,0" Click="OnLoadThemeClick" ToolTip="{DynamicResource HL.Tip.Themes.LoadTheme}" />
                    <Button Content="Sa_ve Settings As Theme…" Click="OnSaveThemeClick" ToolTip="{DynamicResource HL.Tip.Themes.SaveTheme}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ListPane" Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,14,12,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Bulb List" Style="{DynamicResource HL.Style.Text.BodyStrong}" Margin="0,0,0,8"
                           AutomationProperties.HeadingLevel="Level2" ToolTip="{DynamicResource HL.Tip.BulbFactory.BulbList}" />
                <gallery:BulbList x:Name="List" Grid.Row="1" />
                <gallery:SelectedBulbBar x:Name="Bar" Grid.Row="2" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
