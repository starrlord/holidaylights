{
  "schema": "holidaylights.theme/1",
  "name": "Holiday Party",
  "shipped": "new",
  "arrangement": {
    "top": [
      "addon:StarlightBulbs"
    ],
    "right": [
      "addon:ShinyBulbs"
    ],
    "bottom": [
      "addon:SparklieBulbs2"
    ],
    "left": [
      "addon:ShinyBulbs"
    ],
    "topLeft": "builtin:party-hats",
    "topRight": "builtin:party-hats",
    "bottomLeft": "builtin:party-hats",
    "bottomRight": "builtin:party-hats"
  },
  "flash": {
    "pattern": "danceToMusic",
    "interval": 3
  },
  "music": {
    "enabledSongs": [
      "bundled:Deck the Halls (Reggae).mid",
      "bundled:Jingle Bells (Reggae).mid",
      "bundled:We Wish You a Merry Christmas (Reggae).mid",
      "bundled:God Rest Ye Merry Gentlemen (Reggae).mid",
      "bundled:Joy of Man's Desire (Reggae).mid",
      "bundled:O Christmas Tree (Swing).mid",
      "bundled:Auld Lang Syne (Swing).mid",
      "bundled:Hava Nagilah.mid"
    ],
    "mode": "always"
  },
  "saver": {
    "animation": "Balloons",
    "style": "bounceOffSides",
    "message": "Let's Celebrate!",
    "font": {
      "family": "Arial Black",
      "sizePt": 48,
      "bold": false,
      "italic": false,
      "underline": false,
      "strikeout": false
    },
    "color": "#F4B942",
    "background": "#0B1530",
    "picture": "(None)",
    "placement": "center"
  }
}
