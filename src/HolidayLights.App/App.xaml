<!--
  The WPF application (owner: app-shell). Built as a Page (not an ApplicationDefinition): Program.Main is the entry point.
  ThemeMode="System": WPF's built-in Fluent theme, Mica, light/dark and accent from Windows (PRODUCT-SPEC D19).
-->
<Application x:Class="HolidayLights.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Assets/Illustrations.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
