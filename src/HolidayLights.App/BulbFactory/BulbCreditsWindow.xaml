<!--
  Bulb Credits (owner: bulb-factory; PRODUCT-SPEC 3.3.3): the caption is the bulb's name; the
  preview animation, the 5.4 notice, "Author" and "Copyright Information" as selectable plain text, the source, "OK".
-->
<Window x:Class="HolidayLights.App.BulbFactory.BulbCreditsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HolidayLights.App.Controls"
        Title="{Binding Title}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="PlainText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <controls:NightWell HorizontalAlignment="Center" Padding="16" CornerRadius="4">
            <Image Source="{Binding CurrentFrame}" Width="{Binding PictureWidth}" Height="{Binding PictureHeight}"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="{Binding Title}" />
        </controls:NightWell>

        <TextBlock Margin="0,16,0,0" Text="{Binding Notice}" TextWrapping="Wrap" />

        <TextBlock Text="Author" Style="{StaticResource GroupHeader}" />
        <TextBox Text="{Binding Author, Mode=OneWay}" Style="{StaticResource PlainText}" AutomationProperties.Name="Author" />
        <TextBlock Text="Copyright Information" Style="{StaticResource GroupHeader}" />
        <TextBox Text="{Binding Copyright, Mode=OneWay}" Style="{StaticResource PlainText}" AutomationProperties.Name="Copyright Information" />

        <TextBlock Margin="0,16,0,0" Text="{Binding Source}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Show in Folder" MinWidth="120" Command="{Binding ShowInFolderCommand}"
                    Visibility="{Binding CanShowInFolder, Converter={StaticResource BoolVisibility}}" />
            <Button DockPanel.Dock="Right" Content="OK" MinWidth="96" IsDefault="True" IsCancel="True"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </StackPanel>
</Window>
