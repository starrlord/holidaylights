<!--
  Default styles of the templated controls in Controls/ (owner: settings-ui), found through
  [assembly: ThemeInfo(..., ResourceDictionaryLocation.SourceAssembly)] in AssemblyInfo.cs. Every brush is a Fluent
  system brush referenced with DynamicResource, so the controls follow light, dark and High Contrast live (PRODUCT-SPEC
  3.0.1, 4.5).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HolidayLights.App.Controls">

    <FontFamily x:Key="HL.Generic.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Small glyph buttons used inside the templates below (close buttons, spin buttons). -->
    <Style x:Key="HL.Generic.GlyphButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource HL.Generic.IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card -->
    <Style TargetType="local:Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Card">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderRow" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}" AutomationProperties.HeadingLevel="Level2" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="{TemplateBinding Description}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ContentPresenter Grid.Row="2" Margin="0,8,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NightWell -->
    <Style TargetType="local:NightWell">
        <Setter Property="Background" Value="{DynamicResource HL.Brush.NightWell}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- InfoBar -->
    <Style TargetType="local:InfoBar">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:InfoBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" MinHeight="48" Padding="14,6,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="Icon" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="IconBackground" Text="&#xEA3B;" FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource InfoBarInformationalSeverityIconBackground}" />
                                <TextBlock x:Name="IconGlyph" Text="&#xF13F;" FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorInverseBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,4" Foreground="{TemplateBinding Foreground}" />
                            <WrapPanel x:Name="Actions" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="ActionButton" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                                        Margin="0,2,8,2" MinWidth="72" />
                                <Button x:Name="SecondaryActionButton" Content="{TemplateBinding SecondaryActionText}"
                                        Command="{TemplateBinding SecondaryActionCommand}" Margin="0,2,8,2" MinWidth="72" />
                            </WrapPanel>
                            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource HL.Generic.GlyphButton}" Content="&#xE711;"
                                    Command="{x:Static local:InfoBar.CloseCommand}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Close" ToolTip="Close" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13E;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13C;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13D;" />
                        </Trigger>
                        <Trigger Property="ActionText" Value="{x:Null}">
                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SecondaryActionText" Value="{x:Null}">
                            <Setter TargetName="SecondaryActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="Actions" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Actions" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Actions" Property="Margin" Value="0,2,0,4" />
                            <Setter TargetName="Icon" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="Icon" Property="Margin" Value="0,6,12,0" />
                            <Setter TargetName="CloseButton" Property="VerticalAlignment" Value="Top" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ContentDialogCard -->
    <Style TargetType="local:ContentDialogCard">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ContentDialogCard">
                    <Border Background="{DynamicResource ContentDialogBackground}" BorderBrush="{DynamicResource ContentDialogBorderBrush}"
                            BorderThickness="1" CornerRadius="8" MinWidth="320" MaxWidth="548">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource ContentDialogTopOverlay}" CornerRadius="8,8,0,0" Padding="24"
                                    BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.HeadingLevel="Level1" />
                                    <TextBlock Text="{TemplateBinding Text}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PrimaryButton" Content="{TemplateBinding PrimaryButtonText}" HorizontalAlignment="Stretch"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button x:Name="PART_CloseButton" Grid.Column="2" Content="{TemplateBinding CloseButtonText}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="PrimaryIsDestructive" Value="True">
                            <Setter TargetName="PART_PrimaryButton" Property="Style" Value="{DynamicResource DefaultButtonStyle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Snackbar: the inverted surface is the primary text colour, its text the inverse text colour. -->
    <Style x:Key="HL.Generic.SnackbarButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:Snackbar">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
        <Setter Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="16,0,16,16" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Snackbar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Message}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}" />
                            <Button x:Name="PART_ActionButton" Grid.Column="1" Content="{TemplateBinding ActionText}" Margin="12,0,0,0"
                                    Style="{StaticResource HL.Generic.SnackbarButton}" />
                            <Button x:Name="PART_CloseButton" Grid.Column="2" Margin="4,0,0,0" Content="&#xE711;" Width="32"
                                    FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="12" FontWeight="Normal"
                                    Style="{StaticResource HL.Generic.SnackbarButton}" Padding="0"
                                    AutomationProperties.Name="Close" ToolTip="Close" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActionText" Value="{x:Null}">
                            <Setter TargetName="PART_ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NumberBox -->
    <Style TargetType="local:NumberBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NumberBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PART_TextBox" MinWidth="56" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                 AutomationProperties.LabeledBy="{TemplateBinding AutomationProperties.LabeledBy}" />
                        <RepeatButton x:Name="PART_UpButton" Grid.Column="1" Margin="4,0,0,0" Content="&#xE70E;" Focusable="False"
                                      Style="{StaticResource HL.Generic.GlyphButton}" AutomationProperties.Name="Increase" />
                        <RepeatButton x:Name="PART_DownButton" Grid.Column="2" Content="&#xE70D;" Focusable="False"
                                      Style="{StaticResource HL.Generic.GlyphButton}" AutomationProperties.Name="Decrease" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SplitButton -->
    <Style TargetType="local:SplitButton">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SplitButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PrimaryButton" Content="{TemplateBinding Content}" Command="{TemplateBinding Command}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" Padding="10,4"
                                    Style="{DynamicResource HL.Style.Button.Subtle}"
                                    ToolTip="{TemplateBinding ToolTip}"
                                    AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                    AutomationProperties.HelpText="{TemplateBinding AutomationProperties.HelpText}" />
                            <Rectangle Grid.Column="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,6" />
                            <Button x:Name="PART_MenuButton" Grid.Column="2" Content="&#xE70D;" Width="28" Padding="0"
                                    FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="10"
                                    Style="{DynamicResource HL.Style.Button.Subtle}"
                                    AutomationProperties.Name="{TemplateBinding MenuButtonName}" ToolTip="{TemplateBinding MenuButtonName}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- HotKeyRecorder: key caps; a recording field when not read-only. -->
    <DataTemplate x:Key="HL.Generic.KeyCapTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Plus" Text="+" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Border CornerRadius="4" Padding="8,2" MinWidth="28" BorderThickness="1,1,1,2"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                <TextBlock Text="{Binding}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter TargetName="Plus" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="local:HotKeyRecorder">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HotKeyRecorder">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <ItemsControl x:Name="CapsList" ItemsSource="{TemplateBinding Caps}" ItemTemplate="{StaticResource HL.Generic.KeyCapTemplate}"
                                          Focusable="False" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="Prompt" Text="Press the keys you want to use" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Chrome" Property="Padding" Value="11,7" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsRecording" Value="True" />
                                <Condition Property="Binding" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Prompt" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PageHeader -->
    <Style TargetType="local:PageHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PageHeader">
                    <!-- The title row holds the page's actions and Undo/Redo; the description has the whole width below it. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{TemplateBinding Title}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                                   VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" AutomationProperties.HeadingLevel="Level1" />
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding Commands}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DescriptionText" Grid.Row="1" Grid.ColumnSpan="3" Text="{TemplateBinding Description}" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ArrangementChip: a chip, a "+" or a corner of the frame editor. -->
    <Style x:Key="HL.Generic.ChipRemoveButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" CornerRadius="9" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="8" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ArrangementChip">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ArrangementChip">
                    <Grid>
                        <local:NightWell x:Name="Well">
                            <Grid>
                                <local:BulbThumbnail x:Name="Art" Margin="3" MaxArtScale="1.5" FallbackToListPreview="True"
                                                     Services="{TemplateBinding Services}" BulbId="{TemplateBinding BulbId}"
                                                     Slot="{TemplateBinding Slot}" IsAnimated="{TemplateBinding IsAnimated}" />
                                <local:BulbThumbnail x:Name="TryOnArt" Margin="3" MaxArtScale="1.5" FallbackToListPreview="True" Visibility="Collapsed"
                                                     Services="{TemplateBinding Services}" BulbId="{TemplateBinding TryOnBulbId}"
                                                     Slot="{TemplateBinding Slot}" IsAnimated="{TemplateBinding IsAnimated}" />
                            </Grid>
                        </local:NightWell>
                        <Rectangle x:Name="TryOnFrame" RadiusX="4" RadiusY="4" StrokeDashArray="2 2" StrokeThickness="1.5" Visibility="Collapsed"
                                   Stroke="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <Rectangle x:Name="PlusFrame" RadiusX="4" RadiusY="4" StrokeDashArray="3 2" StrokeThickness="1" Visibility="Collapsed"
                                   Stroke="{DynamicResource TextFillColorTertiaryBrush}" Fill="Transparent" />
                        <TextBlock x:Name="PlusGlyph" Text="&#xE710;" FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="MissingGlyph" Text="&#xE7BA;" FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <Border x:Name="OrderBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" CornerRadius="3"
                                Padding="3,0,3,1" Background="#B0000000" IsHitTestVisible="False">
                            <TextBlock Text="{Binding Order, RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" Foreground="White" />
                        </Border>
                        <Border x:Name="SelectionFrame" Margin="-3" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Border x:Name="ReplaceFrame" Margin="-3" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="3" Padding="3,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-9">
                                <TextBlock Text="Replace" FontSize="9" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Border>
                        <Rectangle x:Name="InsertBefore" Width="2" Margin="-4,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <Rectangle x:Name="InsertAfter" Width="2" Margin="0,0,-4,0" HorizontalAlignment="Right" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <Rectangle x:Name="InsertAbove" Height="2" Margin="0,-4,0,0" VerticalAlignment="Top" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <Rectangle x:Name="InsertBelow" Height="2" Margin="0,0,0,-4" VerticalAlignment="Bottom" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <Button x:Name="RemoveButton" Style="{StaticResource HL.Generic.ChipRemoveButton}" Command="{x:Static local:ArrangementChip.RemoveCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Visibility="Collapsed"
                                ToolTip="Remove" AutomationProperties.Name="Remove" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="BulbId" Value="{x:Null}">
                            <Setter TargetName="Well" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlusFrame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlusGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OrderBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Order" Value="0">
                            <Setter TargetName="OrderBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="Art" Property="IsMissing" Value="True">
                            <Setter TargetName="MissingGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPlus" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsPlus" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="BulbId" Value="{x:Null}">
                            <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsTryingOn" Value="True">
                            <Setter TargetName="Well" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TryOnArt" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TryOnFrame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlusFrame" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlusGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MissingGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlusFrame" Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionFrame" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReplaceTarget" Value="True">
                            <Setter TargetName="ReplaceFrame" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Insertion" Value="Before" />
                                <Condition Property="IsVertical" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InsertBefore" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Insertion" Value="After" />
                                <Condition Property="IsVertical" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InsertAfter" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Insertion" Value="Before" />
                                <Condition Property="IsVertical" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InsertAbove" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Insertion" Value="After" />
                                <Condition Property="IsVertical" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InsertBelow" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FlyoutPresenter (flyouts and teaching tips) -->
    <Style TargetType="local:FlyoutPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource FlyoutBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlyoutBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:FlyoutPresenter">
                    <Border Margin="12,4,12,16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.26" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="TitleRow" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <Button x:Name="CloseButton" Grid.Column="1" Content="&#xE711;" Style="{StaticResource HL.Generic.GlyphButton}"
                                        Command="{x:Static local:FlyoutPresenter.CloseCommand}" Margin="8,-6,-6,0"
                                        AutomationProperties.Name="Close" ToolTip="Close" />
                            </Grid>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SearchBox: a Fluent text box with a placeholder, a search glyph and a clear button. -->
    <Style TargetType="local:SearchBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SearchBox">
                    <Grid>
                        <TextBox x:Name="PART_TextBox" Padding="10,5,64,6" VerticalContentAlignment="Center"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Margin="12,0,64,1" VerticalAlignment="Center"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <Button x:Name="PART_ClearButton" Style="{StaticResource HL.Generic.GlyphButton}" Width="28" Height="24"
                                    Content="&#xE711;" Focusable="False" Visibility="Collapsed" ToolTip="Clear Search"
                                    AutomationProperties.Name="Clear Search" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource HL.Generic.IconFont}" FontSize="14" Margin="6,0,8,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasText" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
