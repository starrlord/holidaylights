<Project Sdk="Microsoft.NET.Sdk">

  <!-- Branding generator (owner: branding-docs). Renders the Holiday Lights 6 icons, the heritage banners and the help
       pictures from vector drawings with WPF (RenderTargetBitmap) and writes them into the App's Assets and HelpContent
       folders. A developer tool: it is not part of HolidayLights.sln and nothing ships from it. See ../README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BrandingGenerator</AssemblyName>
    <RootNamespace>HolidayLights.Branding</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Directory.Build.props adds the product's contract namespace to every project; this tool does not reference the
       product (it reads the repository's art files directly). -->
  <ItemGroup>
    <Using Remove="HolidayLights.Core.Abstractions" />
  </ItemGroup>

  <!-- The rules for the add-on artist credits and the user guide live with the Branding tests, which check the
       committed credits.json, Art Copyright topic and docs/USER-GUIDE.md against them; this tool writes those files. -->
  <ItemGroup>
    <Compile Include="..\..\..\tests\HolidayLights.Tests\Branding\AddOnArtistCredits.cs" Link="Shared\AddOnArtistCredits.cs" />
    <Compile Include="..\..\..\tests\HolidayLights.Tests\Branding\UserGuideComposer.cs" Link="Shared\UserGuideComposer.cs" />
  </ItemGroup>

</Project>
